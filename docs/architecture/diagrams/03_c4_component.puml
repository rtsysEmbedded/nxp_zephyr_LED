@startuml 03_c4_component
!include <C4/C4_Component>

title Portable GPIO library - C4 Level 3: Components of the run-time library

LAYOUT_TOP_DOWN()

Container_Ext(app, "Application", "C++", "Tasks / threads / super-loop")

Container_Boundary(core, "Portable core (no OS includes)") {
  Component(facade, "GpioSystem", "Facade + Factory", "Two-phase init/start, name -> handle lookup at init only, poll() for bare-metal, owns all ports.")
  Component(pins, "OutputPin / InputPin", "Value handles", "Stateless: {IGpioPort*, mask, active_low}. No lock, no shadow.")
  Component(disp, "EventDispatcher", "Observer", "Subscription table frozen at start(); diff -> callbacks in task / work / poll context only.")
  Component(iport, "IGpioPort", "Interface (Bridge implementor)", "write_masked, toggle_masked, read, configure, caps(), service().")
  Component(expport, "ExpanderPort", "Port + shadow registers", "Port mutex, shadow out/dir/in, dirty + resync flags, fail-safe handling.")
  Component(chip, "IExpanderChip", "Strategy", "Pca95xxChip, Mcp23x17Chip, ShiftRegChip: framing + IRQ semantics; register map from generated data.")
  Component(ibus, "IBus", "Interface (Adapter target)", "transfer(), mutex(): one per physical bus.")
  Component(cfgsrc, "IConfigSource", "Interface", "Generated constexpr tables (MCU) or JSON loader (Linux).")
}

Container_Boundary(adp, "Platform adapters (exactly one set linked)") {
  Component(native, "Native port", "IGpioPort impl", "McuxGpioPort | ZephyrGpioPort | LinuxGpiodPort")
  Component(bus, "Bus adapters", "IBus impl", "Mcux I2C/SPI (blocking | FreeRTOS | async) | Zephyr i2c/spi | Linux i2c-dev/spidev")
  Component(osal, "OSAL", "Link-time selected, no virtual", "Mutex, ScopedLock, CriticalSection, Context, EventSignal, Clock")
}

Rel(app, facade, "init(), start(), output(name), subscribe()")
Rel(app, pins, "set(), toggle(), read()")
Rel(pins, iport, "write_masked / read")
Rel(facade, cfgsrc, "Reads descriptors")
Rel(facade, iport, "Creates + owns")
Rel(facade, disp, "Owns")
Rel_U(iport, disp, "Reports changed bits", "from service()")
Rel(expport, iport, "Implements")
Rel(native, iport, "Implements")
Rel(expport, chip, "Delegates encoding")
Rel(expport, ibus, "Transfers")
Rel(bus, ibus, "Implements")
Rel(expport, osal, "Mutex, ScopedLock, Context")
Rel(native, osal, "CriticalSection, EventSignal")
Rel(disp, osal, "EventSignal, Context")

SHOW_LEGEND()
@enduml
