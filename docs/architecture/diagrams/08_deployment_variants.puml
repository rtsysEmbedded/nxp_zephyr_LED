@startuml 08_deployment_variants
!include _style.iuml

title Build variants - what is linked on each target (UML deployment diagram)

node "Build host" as host {
  artifact "config/hal.json\nconfig/chips/*.json" as json
  artifact "hal_codegen.py" as gen
  artifact "hal_config.hpp\n(constexpr tables, init order)" as hpp
  artifact "hal.overlay\nhal.conf (Kconfig)" as dts
  json --> gen
  gen --> hpp
  gen --> dts
}

node "Linux SBC / host PC" as linux {
  node "Linux process" {
    component "hal modules (portable)" as c1
    component "LinuxGpiodPort\nLinuxI2cDev, LinuxSpidev\nosal/linux (std::mutex)" as a1
    artifact "hal.json\n(runtime, JsonConfigSource)" as rj
  }
  node "Kernel" {
    component "gpiolib + pca953x / mcp23s08\ni2c, spi, i2c-gpio, spi-gpio drivers" as k1
  }
  a1 --> k1 : libgpiod v2
}

node "FRDM-MCXN947 (Cortex-M33)" as board {
  node "Variant A: Zephyr" as z {
    component "hal modules (portable)" as c2
    component "ZephyrGpioPort\nZephyrI2c, ZephyrSpi\nosal/zephyr (k_mutex, k_spinlock, k_work)" as a2
  }
  node "Variant B: FreeRTOS + MCUXpresso SDK" as f {
    component "hal modules (portable)\nincl. BitBangI2c / BitBangSpi" as c3
    component "McuxGpioPort\nMcuxLpi2c, McuxLpspi (rtos mode)\nosal/freertos (static mutex, task notify)" as a3
  }
  node "Variant C: bare-metal + MCUXpresso SDK" as b {
    component "hal modules (portable)\nincl. BitBangI2c / BitBangSpi" as c4
    component "McuxGpioPort\nMcuxLpi2c, McuxLpspi (blocking | async)\nosal/baremetal (PRIMASK/BASEPRI)" as a4
  }
}

hpp ..> c2 : compiled in
hpp ..> c3 : compiled in
hpp ..> c4 : compiled in
dts ..> z : west build
json ..> rj : installed

c1 --> a1
c2 --> a2
c3 --> a3
c4 --> a4

note bottom of board
  On Linux and Zephyr, bit-banged buses come from OS drivers (ADR-0006);
  the library bit-bang controllers are linked only for FreeRTOS / bare-metal.
  Exactly one variant per image.
  Selected by CMake cache variables HAL_OS and HAL_SILICON
  (values come from CMakePresets.json, not from source code).
end note
@enduml
