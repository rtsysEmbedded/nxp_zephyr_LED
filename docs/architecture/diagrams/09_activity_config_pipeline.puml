@startuml 09_activity_config_pipeline
!include _style.iuml

title Configuration pipeline - JSON as single source of truth (UML activity diagram)

start
:Read config/gpio.json and config/chips/*.json;
:Validate against gpio.schema.json\n(types, enums, required fields, schema_version);
if (schema valid?) then (no)
  :Print JSON path + reason;
  stop
endif
:Semantic validation;
note right
  - pin used twice / index >= port width
  - can_sleep port used as ISR-time source
  - IRQ priority not allowed by RTOS
    (FreeRTOS: numerically >= configMAX_SYSCALL_INTERRUPT_PRIORITY)
  - bus referenced but not defined
  - fail_safe missing for an output
  - port owned by more than one core
end note
if (semantically valid?) then (no)
  :Fail build with diagnostic;
  stop
endif
switch (GPIO_OS)
case (linux)
  :Install gpio.json next to binary\n(JsonConfigSource parses at start-up);
case (zephyr)
  :Emit gpio.overlay (expander nodes only;\nnever redefine board nodes);
  :Emit gpio.conf Kconfig fragment;
  :Emit gpio_config.hpp;
case (freertos)
  :Emit gpio_config.hpp;
case (baremetal)
  :Emit gpio_config.hpp;
endswitch
:Compile portable core + selected adapters;
stop
@enduml
