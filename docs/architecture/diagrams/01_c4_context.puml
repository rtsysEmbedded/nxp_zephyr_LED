@startuml 01_c4_context
!include <C4/C4_Context>

title Portable HAL (GPIO, I/O expanders, I2C, SPI) - C4 Level 1: System Context

LAYOUT_TOP_DOWN()

Person(dev, "Firmware / application developer", "Writes application logic and chip drivers against the hal package and maintains the JSON configuration.")
Person(hw, "Hardware engineer", "Defines pin assignment, expander chips, bus wiring and fail-safe levels.")

System(gpiolib, "Portable HAL (package hal)", "C++17 library: GPIO (native and I/O-expander pins), I2C and SPI (hardware peripheral or GPIO bit-bang) on Linux, Zephyr, FreeRTOS and bare-metal.")

System_Ext(build, "Build toolchain", "CMake, west (Zephyr), MCUXpresso SDK build, Python code generator.")
System_Ext(os, "Execution platform", "Linux kernel (gpiolib, i2c-dev, spidev) | Zephyr RTOS | FreeRTOS | bare-metal + MCUXpresso SDK.")
System_Ext(soc, "SoC hardware", "e.g. MCXN947 GPIO0..5 (PSOR/PCOR/PTOR), LP_FLEXCOMM (LPI2C, LPSPI), PORT pin mux, NVIC.")
System_Ext(exp, "I/O expander chips", "I2C: PCA95xx/TCA95xx, MCP23017. SPI: MCP23S17, 74HC595.")
System_Ext(dev2, "Other I2C / SPI devices", "Sensors, EEPROMs, displays, flash.")

Rel(dev, gpiolib, "Uses API, edits config/hal.json")
Rel(hw, gpiolib, "Provides pin map and chip list", "config/hal.json")
Rel(build, gpiolib, "Validates config, generates tables, compiles the selected variant")
Rel(gpiolib, os, "Calls OS / SDK services", "mutex, ISR deferral, bus drivers")
Rel(gpiolib, soc, "Drives native pins and I2C/SPI peripherals", "via OS driver or SDK")
Rel(gpiolib, exp, "Drives expander pins", "I2C / SPI transactions")
Rel(gpiolib, dev2, "Register access", "I2C / SPI")
Rel(exp, soc, "INT line", "open-drain, active low")

SHOW_LEGEND()
@enduml
